{
  "name": "freestream",
  "version": "1.4.0",
  "private": true,
  "description": "FREESTREAM — régie de présentation et de diffusion 100% offline pour OBS",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:http": "node --test tests/http.test.mjs",
    "test:render": "node --test tests/render.test.mjs",
    "convert": "node outils/convertir.mjs",
    "export": "node outils/exporter.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:py": "python3 -m py_compile server.py",
    "test:powershell": "node --test tests/powershell.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "web-tree-sitter": "^0.27.1",
    "@vscode/tree-sitter-wasm": "^0.3.1"
  }
}
